<?xml version="1.0" encoding="UTF-8"?>

<!--
    Payment table: "order first, enrollment after payment".

    - payment rows carry the student and what is being bought (course or program),
      so they can exist before any enrollment row.
    - enrollment rows are created only when a payment is PAID (online, offline, waiver or free).
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           http://www.liquibase.org/xml/ns/dbchangelog
           http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.15.xsd">

    <!-- 1. payment table -->
    <changeSet id="202611111200-1" author="afsheen">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="payment"/>
            </not>
        </preConditions>

        <createTable tableName="payment">

            <!-- Primary Key -->
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <!-- Who is paying and for what (copied into enrollment on success) -->
            <column name="student_id" type="CHAR(7)">
                <constraints nullable="false"/>
            </column>

            <!-- COURSE / PROGRAM -->
            <column name="enrollment_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>

            <column name="course_id" type="VARCHAR(50)"/>

            <column name="program_id" type="VARCHAR(50)"/>

            <!-- Filled only when the payment is settled and the enrollment is created -->
            <column name="enrollment_id" type="BIGINT"/>

            <!-- ONLINE / OFFLINE / WAIVER / FREE -->
            <column name="method" type="VARCHAR(20)" defaultValue="ONLINE">
                <constraints nullable="false"/>
            </column>

            <!-- CASH / BANK_TRANSFER / CHEQUE / UPI (OFFLINE only) -->
            <column name="offline_mode" type="VARCHAR(20)"/>

            <!-- CREATED / PAID / FAILED / ... -->
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>

            <!-- Razorpay identifiers (ONLINE only) -->
            <column name="razorpay_order_id" type="VARCHAR(50)"/>

            <column name="razorpay_payment_id" type="VARCHAR(50)"/>

            <column name="razorpay_signature" type="VARCHAR(255)"/>

            <!-- Fee snapshot (server calculated) -->
            <column name="fee_amount" type="DECIMAL(10,2)"/>

            <column name="discount_amount" type="DECIMAL(10,2)"/>

            <!-- Amount payable / received in rupees -->
            <column name="amount" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>

            <column name="currency" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>

            <!-- Receipt / UTR / cheque number (OFFLINE only) -->
            <column name="reference_no" type="VARCHAR(100)"/>

            <column name="remarks" type="VARCHAR(255)"/>

            <column name="failure_reason" type="VARCHAR(500)"/>

            <!-- Email of the student or admin who started the payment -->
            <column name="initiated_by" type="VARCHAR(100)"/>

            <!-- Staff id of the admin who recorded an OFFLINE payment or WAIVER -->
            <column name="recorded_by" type="BIGINT"/>

            <!-- Unpaid online orders expire after this time -->
            <column name="expires_at" type="TIMESTAMP NULL"/>

            <column name="paid_at" type="TIMESTAMP NULL"/>

            <!-- Refunds -->
            <column name="razorpay_refund_id" type="VARCHAR(50)"/>

            <column name="refunded_amount" type="DECIMAL(10,2)"/>

            <column name="refunded_at" type="TIMESTAMP NULL"/>

            <!-- Audit Fields -->
            <column name="created_dt"
                    type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP"/>

            <column name="created_by" type="BIGINT"/>

            <column name="updated_dt"
                    type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP"/>

            <column name="updated_by" type="BIGINT"/>

        </createTable>

        <!-- Foreign Keys -->
        <addForeignKeyConstraint
                baseTableName="payment"
                baseColumnNames="student_id"
                referencedTableName="student"
                referencedColumnNames="student_id"
                constraintName="fk_payment_student"/>

        <addForeignKeyConstraint
                baseTableName="payment"
                baseColumnNames="course_id"
                referencedTableName="course"
                referencedColumnNames="course_id"
                constraintName="fk_payment_course"/>

        <addForeignKeyConstraint
                baseTableName="payment"
                baseColumnNames="program_id"
                referencedTableName="program"
                referencedColumnNames="program_id"
                constraintName="fk_payment_program"/>

        <addForeignKeyConstraint
                baseTableName="payment"
                baseColumnNames="enrollment_id"
                referencedTableName="enrollment"
                referencedColumnNames="id"
                constraintName="fk_payment_enrollment"/>

        <!-- Same order / Razorpay payment / receipt cannot be recorded twice -->
        <addUniqueConstraint tableName="payment" columnNames="razorpay_order_id"
                             constraintName="uk_payment_razorpay_order_id"/>

        <addUniqueConstraint tableName="payment" columnNames="razorpay_payment_id"
                             constraintName="uk_payment_razorpay_payment_id"/>

        <addUniqueConstraint tableName="payment" columnNames="reference_no"
                             constraintName="uk_payment_reference_no"/>

        <!-- Indexes -->
        <createIndex tableName="payment" indexName="idx_payment_enrollment_id">
            <column name="enrollment_id"/>
        </createIndex>

        <createIndex tableName="payment" indexName="idx_payment_student_status">
            <column name="student_id"/>
            <column name="status"/>
        </createIndex>

        <createIndex tableName="payment" indexName="idx_payment_status_expires">
            <column name="status"/>
            <column name="expires_at"/>
        </createIndex>

    </changeSet>


    <!-- 2. enrollment.source (SELF / ADMIN); skipped if the column already exists -->
    <changeSet id="202611111200-2" author="afsheen">

        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="enrollment" columnName="source"/>
            </not>
        </preConditions>

        <addColumn tableName="enrollment">
            <column name="source" type="VARCHAR(10)" defaultValue="SELF"/>
        </addColumn>

    </changeSet>

</databaseChangeLog>
