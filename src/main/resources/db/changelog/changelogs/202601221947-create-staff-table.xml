<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           http://www.liquibase.org/xml/ns/dbchangelog
           http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.15.xsd">

    <changeSet id="2201202609" author="shivashankar">

        <createTable tableName="staff">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="staff_id" type="VARCHAR(20)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="first_nm" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="last_nm" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="addr1" type="VARCHAR(255)"/>
            <column name="addr2" type="VARCHAR(255)"/>
            <column name="city" type="VARCHAR(100)"/>
            <column name="state" type="VARCHAR(100)"/>
            <column name="country" type="VARCHAR(100)"/>
            <column name="pin" type="VARCHAR(10)"/>

            <column name="email_id" type="VARCHAR(150)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="mobile_num" type="VARCHAR(15)">
                <constraints nullable="false"/>
            </column>

            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="status" type="VARCHAR(20)" defaultValue="ACTIVE"/>
            <column name="enabled" type="CHAR(1)" defaultValue="Y"/>

            <column name="designation" type="VARCHAR(100)"/>

            <column name="emergency_contact_nm" type="VARCHAR(100)"/>
            <column name="emergency_contact_num" type="VARCHAR(20)"/>

            <column name="profile_img" type="BLOB"/>
            <column name="dob" type="DATE"/>

            <column name="created_by" type="BIGINT"/>

            <column name="created_dt"
                    type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP"/>

            <column name="updated_by" type="BIGINT"/>

            <column name="updated_dt"
                    type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP"/>

        </createTable>

    </changeSet>

</databaseChangeLog>
