<?xml version="1.0" encoding="UTF-8"?>

<!--
    Payment workflow: "order first, enrollment after payment".

    - payment rows now carry the student and what is being bought (course or program),
      so they can exist before any enrollment row.
    - enrollment rows are created only when a payment is PAID (online, offline, waiver or free).
    - existing PENDING enrollments are kept ACTIVE with a legacy WAIVER payment so current
      students do not lose access.
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           http://www.liquibase.org/xml/ns/dbchangelog
           http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.15.xsd">

    <!-- 1. New payment columns -->
    <changeSet id="202611051000-1" author="afsheen">

        <addColumn tableName="payment">
            <!-- Who is paying and for what (copied into enrollment on success) -->
            <column name="student_id" type="CHAR(7)"/>
            <column name="enrollment_type" type="VARCHAR(20)"/>
            <column name="course_id" type="VARCHAR(50)"/>
            <column name="program_id" type="VARCHAR(50)"/>

            <!-- ONLINE / OFFLINE / WAIVER / FREE -->
            <column name="method" type="VARCHAR(20)" defaultValue="ONLINE">
                <constraints nullable="false"/>
            </column>

            <!-- CASH / BANK_TRANSFER / CHEQUE / UPI (OFFLINE only) -->
            <column name="offline_mode" type="VARCHAR(20)"/>

            <!-- Fee snapshot -->
            <column name="fee_amount" type="DECIMAL(10,2)"/>
            <column name="discount_amount" type="DECIMAL(10,2)"/>

            <!-- Receipt / UTR / cheque number -->
            <column name="reference_no" type="VARCHAR(100)"/>
            <column name="remarks" type="VARCHAR(255)"/>

            <!-- Audit -->
            <column name="initiated_by" type="VARCHAR(100)"/>
            <column name="recorded_by" type="BIGINT"/>

            <!-- Online order expiry -->
            <column name="expires_at" type="TIMESTAMP NULL"/>

            <!-- Refunds -->
            <column name="razorpay_refund_id" type="VARCHAR(50)"/>
            <column name="refunded_amount" type="DECIMAL(10,2)"/>
            <column name="refunded_at" type="TIMESTAMP NULL"/>
        </addColumn>

        <addColumn tableName="enrollment">
            <!-- SELF / ADMIN -->
            <column name="source" type="VARCHAR(10)" defaultValue="SELF"/>
        </addColumn>

    </changeSet>


    <!-- 2. Relax columns that offline / waiver / pre-enrollment payments do not have -->
    <changeSet id="202611051000-2" author="afsheen">

        <dropNotNullConstraint tableName="payment" columnName="enrollment_id" columnDataType="BIGINT"/>

        <dropNotNullConstraint tableName="payment" columnName="razorpay_order_id" columnDataType="VARCHAR(50)"/>

    </changeSet>


    <!-- 3. Migrate existing data -->
    <changeSet id="202611051000-3" author="afsheen">

        <!-- Copy student and target from the linked enrollment -->
        <sql>
            UPDATE payment p
            JOIN enrollment e ON p.enrollment_id = e.id
            SET p.student_id = e.student_id,
                p.enrollment_type = e.enrollment_type,
                p.course_id = e.course_id,
                p.program_id = e.program_id,
                p.fee_amount = p.amount,
                p.discount_amount = 0
        </sql>

        <!-- Unpaid attempts are no longer tied to an enrollment -->
        <sql>
            UPDATE payment
            SET enrollment_id = NULL
            WHERE status &lt;&gt; 'PAID'
        </sql>

        <!-- Open online orders get the standard 24 hour expiry -->
        <sql>
            UPDATE payment
            SET expires_at = DATE_ADD(created_dt, INTERVAL 24 HOUR)
            WHERE status = 'CREATED'
        </sql>

        <!-- Legacy PENDING enrollments without a payment: keep access, record a waiver -->
        <sql>
            INSERT INTO payment
                (student_id, enrollment_type, course_id, program_id, enrollment_id,
                 method, status, amount, fee_amount, discount_amount, currency,
                 remarks, initiated_by, paid_at, created_dt, updated_dt)
            SELECT e.student_id, e.enrollment_type, e.course_id, e.program_id, e.id,
                   'WAIVER', 'PAID', 0, 0, 0, 'INR',
                   'Legacy enrollment before payment system', 'system',
                   NOW(), NOW(), NOW()
            FROM enrollment e
            WHERE e.status = 'PENDING'
              AND NOT EXISTS (
                    SELECT 1 FROM payment p
                    WHERE p.enrollment_id = e.id AND p.status = 'PAID')
        </sql>

        <sql>
            UPDATE enrollment
            SET status = 'ACTIVE', payment_status = 'WAIVED'
            WHERE status = 'PENDING'
        </sql>

        <sql>
            UPDATE enrollment e
            SET e.payment_status = 'PAID'
            WHERE EXISTS (
                SELECT 1 FROM payment p
                WHERE p.enrollment_id = e.id AND p.status = 'PAID' AND p.method = 'ONLINE')
        </sql>

    </changeSet>


    <!-- 4. Constraints and indexes -->
    <changeSet id="202611051000-4" author="afsheen">

        <addNotNullConstraint tableName="payment" columnName="student_id" columnDataType="CHAR(7)"/>

        <addNotNullConstraint tableName="payment" columnName="enrollment_type" columnDataType="VARCHAR(20)"/>

        <addForeignKeyConstraint
                baseTableName="payment"
                baseColumnNames="student_id"
                referencedTableName="student"
                referencedColumnNames="student_id"
                constraintName="fk_payment_student"/>

        <addForeignKeyConstraint
                baseTableName="payment"
                baseColumnNames="course_id"
                referencedTableName="course"
                referencedColumnNames="course_id"
                constraintName="fk_payment_course"/>

        <addForeignKeyConstraint
                baseTableName="payment"
                baseColumnNames="program_id"
                referencedTableName="program"
                referencedColumnNames="program_id"
                constraintName="fk_payment_program"/>

        <!-- Same receipt cannot be recorded twice; same Razorpay payment cannot be processed twice -->
        <addUniqueConstraint tableName="payment" columnNames="reference_no"
                             constraintName="uk_payment_reference_no"/>

        <addUniqueConstraint tableName="payment" columnNames="razorpay_payment_id"
                             constraintName="uk_payment_razorpay_payment_id"/>

        <createIndex tableName="payment" indexName="idx_payment_student_status">
            <column name="student_id"/>
            <column name="status"/>
        </createIndex>

        <createIndex tableName="payment" indexName="idx_payment_status_expires">
            <column name="status"/>
            <column name="expires_at"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
