<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation=" http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
	
	<changeSet id="202609041742" author="Tejaswini">
	
		<createTable tableName="student_task_submission">
		
			<column name="id" type="BIGINT" autoIncrement="true">
				<constraints primaryKey="true" nullable="false" />
			</column>
			
			<column name="student_task_id" type="BIGINT">
				<constraints nullable="false" />
			</column>
			
			<column name="student_id" type="CHAR(7)">
				<constraints nullable="false" />
			</column>
			
			<column name="submission_notes" type="TEXT" />
			
			<column name="attachments" type="JSON" />
			
			<column name="staff_id" type="VARCHAR(20)">
				<constraints nullable="false" />
				
			</column>
			<column name="status" type="VARCHAR(30)">
				<constraints nullable="false" />
			</column>
			
			<column name="submitted_at" type="TIMESTAMP">
				<constraints nullable="false" />
			</column>
			
			<column name="review_feedback" type="TEXT" />
			
			<column name="points_awarded" type="INT" />
			
			<column name="reviewed_at" type="TIMESTAMP" />
			
			<!-- Audit Fields -->
			<column name="created_by" type="BIGINT" />
			
			<column name="created_dt" type="TIMESTAMP" />
			
			<column name="updated_by" type="BIGINT" />
			
			<column name="updated_dt" type="TIMESTAMP" />
			
		</createTable>
		
		<addForeignKeyConstraint
			baseTableName="student_task_submission"
			baseColumnNames="student_task_id"
			constraintName="fk_sts_student_task"
			referencedTableName="student_task" referencedColumnNames="id" />
			
		<addForeignKeyConstraint
			baseTableName="student_task_submission" baseColumnNames="student_id"
			constraintName="fk_sts_student" referencedTableName="student"
			referencedColumnNames="student_id" />
			
		<addForeignKeyConstraint
			baseTableName="student_task_submission" baseColumnNames="staff_id"
			constraintName="fk_sts_staff" referencedTableName="staff"
			referencedColumnNames="staff_id" />
			
		<createIndex indexName="idx_sts_student_task"
			tableName="student_task_submission">
			<column name="student_task_id" />
		</createIndex>
		
		<createIndex indexName="idx_sts_student"
			tableName="student_task_submission">
			<column name="student_id" />
		</createIndex>
		
		<createIndex indexName="idx_sts_staff"
			tableName="student_task_submission">
			<column name="staff_id" />
		</createIndex>
	</changeSet>
</databaseChangeLog>