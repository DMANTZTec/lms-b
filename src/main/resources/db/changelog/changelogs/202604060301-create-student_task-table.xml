<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="202604060301" author="shiva">

        <!-- ✅ Create Table -->
        <createTable tableName="student_task">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="student_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="topic_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="start_dt" type="TIMESTAMP"/>

            <column name="end_dt" type="TIMESTAMP"/>

            <column name="commit_url" type="VARCHAR(500)"/>

            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="need_help" type="BOOLEAN" defaultValueBoolean="false"/>

            <column name="student_comment_txt" type="VARCHAR(1000)"/>

            <column name="reviewer_comment_txt" type="VARCHAR(1000)"/>

            <!-- ✅ Audit Fields -->
            <column name="created_by" type="BIGINT"/>
            <column name="created_dt" type="TIMESTAMP"/>
            <column name="updated_by" type="BIGINT"/>
            <column name="updated_dt" type="TIMESTAMP"/>

        </createTable>

        <!-- ✅ Foreign Keys -->
        <addForeignKeyConstraint
                baseTableName="student_task"
                baseColumnNames="student_id"
                constraintName="fk_student_task_student"
                referencedTableName="student"
                referencedColumnNames="id"/>

        <addForeignKeyConstraint
                baseTableName="student_task"
                baseColumnNames="topic_id"
                constraintName="fk_student_task_topic"
                referencedTableName="topic"
                referencedColumnNames="id"/>

        <!-- ✅ Unique Constraint -->
        <addUniqueConstraint
                tableName="student_task"
                columnNames="student_id, topic_id"
                constraintName="uk_student_task_student_topic"/>

        <!-- ✅ Indexes (Performance) -->
        <createIndex indexName="idx_student_task_student" tableName="student_task">
            <column name="student_id"/>
        </createIndex>

        <createIndex indexName="idx_student_task_topic" tableName="student_task">
            <column name="topic_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>