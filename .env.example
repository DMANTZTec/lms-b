# ============================================
# LMS UAT Deployment - Environment Variables
# Copy to .env and fill in real values
# ============================================

# MySQL
MYSQL_ROOT_PASSWORD=change-me
DB_USERNAME=change-me
DB_PASSWORD=change-me

# Spring Security
SPRING_SECURITY_USERNAME=admin
SPRING_SECURITY_PASSWORD=change-me

# Mail (Gmail app password)
MAIL_USERNAME=change-me@example.com
MAIL_PASSWORD=change-me

# Strapi
STRAPI_URL=http://lms-strapi:1337
STRAPI_API_TOKEN=change-me

# Twilio
TWILIO_ACCOUNT_SID=change-me
TWILIO_AUTH_TOKEN=change-me
TWILIO_FROM_NUMBER=+1234567890

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=