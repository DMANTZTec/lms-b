<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

	<changeSet id="202606291430" author="Tejaswini">

		<createTable tableName="course_fee">

			<column name="id" type="BIGINT" autoIncrement="true">
				<constraints primaryKey="true"
					primaryKeyName="pk_course_fee" nullable="false" />
			</column>

			<column name="course_id" type="VARCHAR(50)">
				<constraints nullable="false" />
			</column>

			<column name="effective_date" type="DATE">
				<constraints nullable="false" />
			</column>

			<column name="fee" type="DECIMAL(10,2)">
				<constraints nullable="false" />
			</column>

			<column name="discount" type="DECIMAL(10,2)"
				defaultValueNumeric="0.00">
				<constraints nullable="false" />
			</column>

			<!-- Audit Fields -->

			<column name="created_dt" type="TIMESTAMP"
				defaultValueComputed="CURRENT_TIMESTAMP" />

			<column name="created_by" type="BIGINT" />

			<column name="updated_dt" type="TIMESTAMP"
				defaultValueComputed="CURRENT_TIMESTAMP" />

			<column name="updated_by" type="BIGINT" />

		</createTable>

		<!-- Foreign Key -->

		<addForeignKeyConstraint
			baseTableName="course_fee" baseColumnNames="course_id"
			referencedTableName="course" referencedColumnNames="course_id"
			constraintName="fk_course_fee_course" />

		<!-- One fee record per course for an effective date -->

		<addUniqueConstraint tableName="course_fee"
			columnNames="course_id,effective_date"
			constraintName="uk_course_fee_course_effective_date" />

	</changeSet>

</databaseChangeLog>