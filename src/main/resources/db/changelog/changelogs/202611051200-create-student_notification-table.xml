<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation=" http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

	<changeSet id="202611051200" author="Afsheen">

		<createTable tableName="student_notification">

			<column name="id" type="BIGINT" autoIncrement="true">
				<constraints primaryKey="true" nullable="false" />
			</column>

			<column name="student_id" type="CHAR(7)">
				<constraints nullable="false" />
			</column>

			<column name="staff_id" type="VARCHAR(20)">
				<constraints nullable="false" />
			</column>

			<column name="batch_id" type="BIGINT">
				<constraints nullable="false" />
			</column>

			<column name="course_id" type="VARCHAR(20)">
				<constraints nullable="false" />
			</column>

			<column name="message" type="TEXT">
				<constraints nullable="false" />
			</column>

			<!-- Comma separated: IN_APP,EMAIL -->
			<column name="channels" type="VARCHAR(100)">
				<constraints nullable="false" />
			</column>

			<column name="email_status" type="VARCHAR(20)" />

			<column name="is_read" type="BOOLEAN" defaultValueBoolean="false">
				<constraints nullable="false" />
			</column>

			<column name="read_at" type="TIMESTAMP" />

			<column name="sent_at" type="TIMESTAMP">
				<constraints nullable="false" />
			</column>

			<!-- Audit Fields -->
			<column name="created_by" type="BIGINT" />
			<column name="created_dt" type="TIMESTAMP" />
			<column name="updated_by" type="BIGINT" />
			<column name="updated_dt" type="TIMESTAMP" />

		</createTable>

		<addForeignKeyConstraint baseTableName="student_notification" baseColumnNames="student_id"
			constraintName="fk_sn_student" referencedTableName="student" referencedColumnNames="student_id" />

		<addForeignKeyConstraint baseTableName="student_notification" baseColumnNames="staff_id"
			constraintName="fk_sn_staff" referencedTableName="staff" referencedColumnNames="staff_id" />

		<addForeignKeyConstraint baseTableName="student_notification" baseColumnNames="batch_id"
			constraintName="fk_sn_class_batch" referencedTableName="class_batch" referencedColumnNames="id" />

		<addForeignKeyConstraint baseTableName="student_notification" baseColumnNames="course_id"
			constraintName="fk_sn_course" referencedTableName="course" referencedColumnNames="course_id" />

		<createIndex indexName="idx_sn_student_read" tableName="student_notification">
			<column name="student_id" />
			<column name="is_read" />
		</createIndex>

	</changeSet>
</databaseChangeLog>
