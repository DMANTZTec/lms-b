<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="202610081200" author="Afsheen">

        <!-- Nullable: tasks created course-wide (POST /api/instructor/tasks) have no schedule -->
        <addColumn tableName="student_task">
            <column name="schedule_id" type="BIGINT"/>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="student_task"
                baseColumnNames="schedule_id"
                referencedTableName="class_schedule"
                referencedColumnNames="id"
                constraintName="fk_student_task_schedule"/>

    </changeSet>

</databaseChangeLog>
