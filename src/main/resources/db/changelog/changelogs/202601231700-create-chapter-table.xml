<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           http://www.liquibase.org/xml/ns/dbchangelog
           http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.15.xsd">

    <changeSet id="202601231700" author="shiva">

        <createTable tableName="chapter">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <!-- references course.course_id -->
            <column name="course_id" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>

            <!-- chapter number -->
            <column name="chapter_num" type="INT">
                <constraints nullable="false"/>
            </column>

            <column name="chapter_nm" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>

            <column name="chapter_desc" type="TEXT"/>

            <column name="created_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="created_dt"
                    type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="updated_by" type="BIGINT"/>

            <column name="updated_dt"
                    type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- FK: chapter → course (course_id) -->
        <addForeignKeyConstraint
                baseTableName="chapter"
                baseColumnNames="course_id"
                referencedTableName="course"
                referencedColumnNames="course_id"
                constraintName="fk_chapter_course"/>

        <!-- Unique chapter number per course -->
        <addUniqueConstraint
                tableName="chapter"
                columnNames="course_id, chapter_num"
                constraintName="uk_chapter_course_chapter_num"/>

    </changeSet>

</databaseChangeLog>
