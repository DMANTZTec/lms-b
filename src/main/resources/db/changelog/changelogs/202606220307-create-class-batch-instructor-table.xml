<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
     xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="
     http://www.liquibase.org/xml/ns/dbchangelog
     http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.15.xsd">
     
<changeSet id="2026062202-create-class-batch-instructor"
           author="afsheen">

    <createTable tableName="class_batch_instructor">

        <column name="batch_id" type="BIGINT">
            <constraints nullable="false"/>
        </column>

        <column name="staff_id" type="VARCHAR(50)">
            <constraints nullable="false"/>
        </column>

    </createTable>

    <addPrimaryKey
            tableName="class_batch_instructor"
            columnNames="batch_id, staff_id"
            constraintName="pk_class_batch_instructor"/>

    <addForeignKeyConstraint
            baseTableName="class_batch_instructor"
            baseColumnNames="batch_id"
            referencedTableName="class_batch"
            referencedColumnNames="id"
            constraintName="fk_class_batch_instructor_batch"
            onDelete="CASCADE"/>

    <addForeignKeyConstraint
            baseTableName="class_batch_instructor"
            baseColumnNames="staff_id"
            referencedTableName="staff"
            referencedColumnNames="staff_id"
            constraintName="fk_class_batch_instructor_staff"
            onDelete="CASCADE"/>

    <createIndex
            tableName="class_batch_instructor"
            indexName="idx_class_batch_instructor_batch_id">

        <column name="batch_id"/>

    </createIndex>

    <createIndex
            tableName="class_batch_instructor"
            indexName="idx_class_batch_instructor_staff_id">

        <column name="staff_id"/>

    </createIndex>

</changeSet>


</databaseChangeLog>
